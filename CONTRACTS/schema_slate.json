{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vanus.local/contracts/schema_slate.json",
  "title": "VANUS slate",
  "description": "Matchs du jour pour UN index et UNE competition. Unite = match, pas un marche.",
  "type": "object",
  "required": ["contract", "index", "competition", "slate_date", "captured_at", "matches"],
  "properties": {
    "contract": { "const": "vanus.slate.v1" },
    "index": {
      "type": "string",
      "enum": ["predictlix", "dailysportpick", "metapred", "footinsights", "besoccer", "vitibet"]
    },
    "competition": { "type": "string", "minLength": 1 },
    "slate_date": { "type": "string", "format": "date" },
    "captured_at": { "type": "string", "format": "date-time" },
    "source_url": { "type": "string", "format": "uri" },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["home", "away", "kickoff"],
        "properties": {
          "home": { "type": "string" },
          "away": { "type": "string" },
          "kickoff": { "type": "string", "format": "date-time" },
          "score": { "type": ["string", "null"] },
          "pick": { "type": ["string", "null"] },
          "model_pct": { "type": ["number", "null"] },
          "odds": {
            "type": "object",
            "additionalProperties": true,
            "description": "Marches comme champs : 1x2, btts, ou_25, ev, pinnacle si deja dans la page."
          },
          "raw_ref": { "type": "string", "description": "Ancre locale, pas une URL a re-fetcher par CELL." }
        }
      }
    }
  },
  "additionalProperties": false
}
